# Normalize line endings to LF in the repository regardless of platform.
* text=auto eol=lf

# Binary assets - never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary

# Generated - collapse in diffs and reviews.
package-lock.json linguist-generated=true -diff
